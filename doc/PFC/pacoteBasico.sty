    %Fonte nos capítulos em 'Times' com tamanho 'normalsize' negrito.
    \renewcommand{\ABNTEXchapterfont}{\fontfamily{ptm}\fontseries{b}\selectfont}
    \renewcommand{\ABNTEXchapterfontsize}{\normalsize}
    
    %Fontes das seções em 'Times' com tamanho 'normalsize'.
    \renewcommand{\ABNTEXsectionfont}{\fontfamily{ptm}\selectfont}
    \renewcommand{\ABNTEXsectionfontsize}{\normalsize}
    
    %Fontes das subseções em 'Times' com tamanho 'normalsize' negrito.
    \renewcommand{\ABNTEXsubsectionfont}{\fontfamily{ptm}\fontseries{b}\selectfont}
    \renewcommand{\ABNTEXsubsectionfontsize}{\normalsize}
    
    %Fontes das sub-subseções em 'Times' com tamanho 'normalsize'.
    \renewcommand{\ABNTEXsubsubsectionfont}{\fontfamily{ptm}\selectfont}
    \renewcommand{\ABNTEXsubsubsectionfontsize}{\normalsize}
    
    %Fontes das sub-sub-subseções em 'Times' com tamanho 'normalsize' itálico.
    \renewcommand{\ABNTEXsubsubsubsectionfont}{\fontfamily{ptm}\fontshape{it}\selectfont}
    \renewcommand{\ABNTEXsubsubsubsectionfontsize}{\normalsize}
    
    %Configuração das fontes do Sumário para cada nível
    \renewcommand\cftchapterfont\textbf   
    \renewcommand\cftsectionfont{\normalfont}%\uppercase
    \renewcommand\cftsubsectionfont\textbf
    \renewcommand\cftsubsubsectionfont\normalfont 
    \renewcommand\cftparagraphfont{\normalfont\textit}
    
%----------------------------------------------------------------------------------------%
    % C A P A   E   F O L H A   D E   R O S T O
%----------------------------------------------------------------------------------------%

    \preambulo{\tipoDeTrabalho, apresentado à Universidade Estadual de Mato Grosso do Sul (UEMS), \nomeDoCurso, \nomeDaCidade, para obtenção do título de \GrauAcademico em \nomeDoCurso.}    
       
% CAPA ----------------------------------------------------------------------------------
    % Formatação conforme modelo UEMS ("9a - Capa"): Times New Roman 12,
    % centralizado; instituição, curso, autor, cidade e ano SEM negrito;
    % apenas o TÍTULO em negrito; instituição/curso/cidade em MAIÚSCULAS.
    \renewcommand{\imprimircapa}{
        \begin{capa}
            \center
            \MakeUppercase{Universidade Estadual de Mato Grosso do Sul}\par
            \MakeUppercase\nomeDoCurso\par

            \vspace*{3cm}

            \nomeDoAutor

            \vfill
                \begin{center}
                    {\bfseries\tituloDoTrabalho}
                    \par \subtituloDoTrabalho
                \end{center}
            \vfill

            \MakeUppercase\nomeDaCidade{} -- MS\par
            \anoDeEntrega
            \vspace*{1cm}
        \end{capa}
    }
    
% FOLHA DE ROSTO ------------------------------------------------------------------------
    \renewcommand{\folhaderostocontent}{
        \begin{center}
        
            {\bfseries\nomeDoAutor}
            
            \vspace*{\fill}\vspace*{\fill}
            
            \begin{center}
                {\bfseries\tituloDoTrabalho }
                \par\subtituloDoTrabalho
            \end{center}
            
            \vspace*{\fill}
            
            \hspace{.45\textwidth}
            \begin{minipage}{.5\textwidth}
                {\SingleSpacing\imprimirpreambulo}
                \par
                \vspace*{1cm}
                Orientador: \tituloDoOrientador\ \nomeDoOrientador\par
                % Descomente a linha abaixo apenas se houver coorientador:
                % Coorientador: \tituloDoCoorientador\ \NomeDoCoorientador
            \end{minipage}
            \vspace*{\fill}

            \vspace*{\fill}
            \normalsize{\MakeUppercase\nomeDaCidade{} -- MS}
            \par
            \normalsize{\anoDeEntrega}
            \vspace*{1cm}
        \end{center}
        \afterpage{\null\setcounter{page}{1}}
        \newpage
    }

